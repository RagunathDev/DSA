// Output: 2
const Input7 = [2,4, 0, 1];
function FindMiss(arr){ 
let n = arr.length;
// 1. Corrected formula with proper parentheses
  let expectedSum = (n * (n + 1)) / 2;
  
  let actualSum = 0;
  
  // 2. Just loop through the array to get the actual sum
  for (let i = 0; i < arr.length; i++) {
    // No .includes() check needed, just add the number
    actualSum += arr[i]; 
  }
  
  // 3. Subtract to find the missing piece
  return expectedSum - actualSum;
}
FindMiss(Input7);

