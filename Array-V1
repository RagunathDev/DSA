// 4. Find Second LargestQuestion: Find the second largest distinct number in an array.

let Input4 = [10, 5,12, 20, 8, 18, 20], Output4 = 10


function secLargest(arrs){ 
    let secLarge = arrs[0];
    let largest = arrs[0];
     for(let i = 1; i < arrs.length; i++){
           if(arrs[i] > largest){
              secLarge = largest;
              largest = arrs[i];
             }
            if(arrs[i] < largest && arrs[i] > secLarge ){
            secLarge = arrs[i]
            }
    }
return secLarge
}
secLargest(Input4);


// 5. Remove DuplicatesQuestion: Remove duplicate elements from an array.
let  Input5 = [1, 2, 2, 3,2, 4, 4, 5], Output5 = [1, 2, 3, 4, 5];
function duplicateRemove(arr){
   // return new Set([...arr])
let res = [];

    for(let i = 0; i < arr.length; i++){
          if(!res.includes(arr[i])){
                res.push(arr[i])
         }
  }
return res
}
duplicateRemove(Input5);

