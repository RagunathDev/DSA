// 10. Merge Sorted Arrays
// Question: Merge two already sorted arrays into a single sorted array.use two pointers (i and j starting at 0). Compare arr1[i] and arr2[j]. Push the smaller one to a new array and increment its pointer. This achieves O(n + m) time complexity.

let Input10 = [1, 3, 5] , Input101 = [2, 4, 6]

function mergeArr(a1, a2){
// return a1.concat(...a2).sort();
let res = [];
let i  = 0;
let j = 0
 
 while( i < a1.length && j < a2.length){
        if(a1[i] < a2[j]){
             res.push(a1[i])
               i++
         }else{
            res.push(a2[j])
            j++
         }
     }
  
    while(i < a1.length){
       res.push(a1[i]);
    i++;
    }

    while(j < a2.length){
       res.push(a2[j]);
    j++;
    }
return res;
}
mergeArr(Input10, Input101);


