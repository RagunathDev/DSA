// 12. Difference of Arrays
// Question: Return the elements that are in the first array but not in the second array.

let Input12l = [1, 2, 3, 4, 5],  Input1d = [2, 4, 6]

  function InterSectionNew(arr, arr2){
        let unique  = new Set();
       let seen = new Set(arr2)

      for(let num of arr){
           if(!seen.has(num)){
              unique.add(num)
          }
      }
      return [...unique];
  }
InterSectionNew(Input12l, Input1d);
